# 대회 데이터 (재배포 금지 — 각자 DACON에서 다운로드)
Data/
data/

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/

# macOS
.DS_Store

# 대용량 산출물 (모델/제출물은 필요 시 선별 커밋)
*.pkl
*.joblib

# 실험용 피처 캐시
cache/

# Local OMX workflow state
.omx/

# 로컬 에이전트 상태
.omc/

# 학습된 모델 바이너리 (435MB) — `python src/train.py` 로 재생성
# 적합 파라미터(terrain_params.npz, v9_feature_cols.json)는 추적한다
models/*.txt

# 외부 데이터(NOAA GEFS)는 추적한다 — 대회 규칙 4항이 "사용한 모든 외부 데이터
# 파일" 제출을 요구하고, 5.6MB 로 작다. 대회 제공 데이터에서 파생된 대용량
# 캐시(full_train 293MB 등)만 제외한다.
!cache/gefs_raw/
!cache/gefs_raw/*.parquet
!cache/gefs_all.parquet
!cache/gefs_hourly.parquet
!cache/gefs_probe.parquet
